# ─── Agora ────────────────────────────────────────────────────────────────────
# App ID is public (the browser needs it for RTC/RTM). Certificate is server-only.
# Write both with: agora project env write .env.local --project Testing --template standard
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_AGORA_APP_CERTIFICATE=

# ─── Google ───────────────────────────────────────────────────────────────────
# Used by both demo architectures: Gemini ASR + Gemini 3.6 Flash (cascaded)
# and Gemini 3.8 Live (native multimodal). Server-only.
NEXT_GOOGLE_API_KEY=

# ─── Deck ─────────────────────────────────────────────────────────────────────
# Overrides the committed development host password AgoraWorkshop2026.
WORKSHOP_HOST_KEY=

# Optional opening line for the demo agent.
# NEXT_AGENT_GREETING=Hi there! I'm Ada, your virtual assistant from Agora. How can I help?
